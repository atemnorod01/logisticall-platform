# Supply staging IAM values; never use production for automated mutation tests.
IAM_ISSUER=https://YOUR-STAGING-PROJECT.supabase.co/auth/v1
IAM_CLIENT_ID=
IAM_API_URL=https://YOUR-STAGING-IAM-API
HOST=127.0.0.1
PORT=3001

# Browser mode is the default and the only mode allowed with NODE_ENV=production.
AUTH_MODE=browser
# Serve the frontend and /auth + /v1 routes under this one HTTPS origin.
APP_ORIGIN=https://YOUR-STAGING-WORKSPACE
# Dedicated database login inheriting platform_session_runtime only; never postgres.
SESSION_DATABASE_URL=
# 32 random bytes encoded as 64 hexadecimal characters; store in service secrets.
SESSION_ENCRYPTION_KEY=
# Optional PEM CA for managed Postgres; verification cannot be disabled.
SESSION_DATABASE_CA=
# Aggregate workspace login starts/minute shared by every replica (staging default).
# Independent gateway per-client limits are still needed before public launch.
LOGIN_PER_MINUTE=120

# WebRTC audio. Empty supports local/direct network connections only.
# For calls across networks, supply your STUN/TURN URLs and browser-scoped credentials.
# Never place a TURN provider management/API key here; values are delivered to authenticated browsers.
CALL_ICE_SERVERS=[]
# Alternative: server-side Cloudflare TURN credential generation.
TURN_KEY_ID=
TURN_API_TOKEN=

# Private Supabase Storage; backend only. Never expose this secret in a browser build.
MEDIA_STORAGE_ORIGIN=https://YOUR-STAGING-PLATFORM.supabase.co
MEDIA_STORAGE_BUCKET=conversation-media
MEDIA_STORAGE_SECRET=
# Optional separate 32-byte hex key; otherwise domain-separated from SESSION_ENCRYPTION_KEY.
MEDIA_SIGNING_KEY=
